                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"runtimeClassName\": \"<string>\",\n  \"constructorArgs\": [\n    \"<object>\",\n    \"<object>\"\n  ]\n}",
              "options": {
