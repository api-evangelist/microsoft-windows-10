          "name": "Microsoft Windows 10 Activate a runtime class",
          "request": {
            "name": "Microsoft Windows 10 Activate a runtime class",
            "description": {
              "content": "Activates (instantiates) a WinRT runtime class by its activation factory. The Windows Runtime uses activation factories to create instances of runtime classes. This is the core mechanism by which UWP apps create objects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "winrt",
                "activation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
