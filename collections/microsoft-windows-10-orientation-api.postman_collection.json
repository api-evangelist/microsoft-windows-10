          "request": {
            "name": "Microsoft Windows 10 Get orientation sensor reading",
            "description": {
              "content": "Retrieves the current orientation sensor reading using OrientationSensor.GetCurrentReading. Returns a rotation matrix and quaternion representing the device's spatial orientation. The orientation sensor fuses data from accelerometer, compass, and gyrometer for smooth results.",
