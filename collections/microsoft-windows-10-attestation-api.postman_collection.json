          "name": "Microsoft Windows 10 Get key attestation",
          "request": {
            "name": "Microsoft Windows 10 Get key attestation",
            "description": {
              "content": "Retrieves attestation information for a Windows Hello key credential using KeyCredential.GetAttestationAsync. Returns a KeyCredentialAttestationResult with an attestation buffer and certificate chain that can be sent to a server to verify the key was generated in a secure environment (TPM).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "hello",
                "attestation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "accountId",
                  "value": "<string>",
                  "description": "(Required) Account identifier for the credential"
                }
              ],
              "variable": []
            },
