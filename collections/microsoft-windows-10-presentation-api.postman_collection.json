              "raw": "{\n  \"width\": \"<integer>\",\n  \"height\": \"<integer>\",\n  \"format\": \"R8G8B8A8_UNORM\",\n  \"bufferCount\": 2,\n  \"swapEffect\": \"FlipDiscard\",\n  \"isWindowed\": true\n}",
