                }
              ],
              "body": "[\n  {\n    \"changeType\": \"ContentsChanged\",\n    \"path\": \"string\",\n    \"previousPath\": \"string\",\n    \"isOfType\": \"Folder\"\n  },\n  {\n    \"changeType\": \"IndexingStatusChanged\",\n    \"path\": \"string\",\n    \"previousPath\": \"string\",\n    \"isOfType\": \"File\"\n  }\n]",
