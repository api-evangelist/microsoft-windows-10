          "name": "Microsoft Windows 10 Get library changes",
          "request": {
            "name": "Microsoft Windows 10 Get library changes",
            "description": {
              "content": "Retrieves change records for a storage library using StorageLibraryChangeTracker and StorageLibraryChangeReader. Returns a list of changes including file/folder creation, modification, deletion, and moves.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "storage",
                "libraries",
                ":libraryId",
                "changes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "libraryId",
                  "description": "(Required) Library identifier (Documents, Music, Pictures, Videos)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "8ee351f9-71ec-43d7-9553-fa4032406871",
              "name": "Successful retrieval of library changes",
              "originalRequest": {
                "url": {
