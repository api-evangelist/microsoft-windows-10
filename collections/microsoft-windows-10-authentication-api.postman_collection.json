          "name": "Microsoft Windows 10 Sign data with a Windows Hello credential",
          "request": {
            "name": "Microsoft Windows 10 Sign data with a Windows Hello credential",
            "description": {
              "content": "Signs a challenge buffer using the Windows Hello credential's private key via KeyCredential.RequestSignAsync. The user is prompted for biometric or PIN verification before the signing operation proceeds. Returns the signed data for server-side verification.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "hello",
                "sign"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
