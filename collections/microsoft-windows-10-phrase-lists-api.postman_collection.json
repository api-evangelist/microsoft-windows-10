          "name": "Microsoft Windows 10 Update a phrase list",
          "request": {
            "name": "Microsoft Windows 10 Update a phrase list",
            "description": {
              "content": "Updates a phrase list within a voice command set using VoiceCommandDefinition.SetPhraseListAsync. Phrase lists are dynamic vocabularies that can be updated at runtime without reinstalling the VCD file.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cortana",
                "voice-commands",
                ":commandSetName",
                "phrase-lists",
                ":phraseListName"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "commandSetName",
                  "description": "(Required) The name of the voice command set"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "phraseListName",
                  "description": "(Required) The name of the phrase list to update"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "PUT",
            "auth": null,
