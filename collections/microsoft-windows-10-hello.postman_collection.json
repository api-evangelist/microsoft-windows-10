  "info": {
    "_postman_id": "5a7f4709-9b5d-4082-95a3-91961653cc94",
    "name": "Microsoft Windows 10 Windows Hello Authentication API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Biometric and PIN-based authentication API that replaces passwords with strong two-factor authentication. Based on the Windows.Security.Credentials namespace, Windows Hello supports facial recognition, fingerprint scanning, and PIN-based user verification for secure sign-in. Key classes include KeyCredentialManager, KeyCredentialRetrievalResult, and UserConsentVerifier. Implements the FIDO2/WebAuthn standards for passwordless authentication.\n\nContact Support:\n Name: Microsoft Developer Support",
      "type": "text/plain"
    }
  }
