          "name": "Microsoft Windows 10 Start continuous position tracking",
          "request": {
            "name": "Microsoft Windows 10 Start continuous position tracking",
            "description": {
              "content": "Starts continuous position tracking by subscribing to the Geolocator.PositionChanged event. Reports position updates based on the configured movement threshold (in meters) and reporting interval.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "geolocation",
                "tracking"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"desiredAccuracy\": \"Default\",\n  \"movementThreshold\": 0,\n  \"reportInterval\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
