  "info": {
    "_postman_id": "f5d887a2-4dab-4bde-9a17-73cb4d660fbe",
    "name": "Microsoft Windows 10 Win32 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Core Windows API for building traditional desktop applications using C and C++. Win32 provides direct access to system-level functionality including window management, graphics, networking, and hardware. This specification models the major Win32 API categories including User Interface, System Services, Graphics, Networking, Security, and Devices.\n\nContact Support:\n Name: Microsoft Developer Support",
      "type": "text/plain"
    }
