            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scanningMode\": \"Active\",\n  \"serviceUuidFilter\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"signalStrengthFilter\": {\n    \"inRangeThresholdInDBm\": \"<integer>\",\n    \"outOfRangeThresholdInDBm\": \"<integer>\"\n  }\n}",
