          "name": "Microsoft Windows 10 List composition visuals",
          "request": {
            "name": "Microsoft Windows 10 List composition visuals",
            "description": {
              "content": "Retrieves the list of visual objects in the composition tree. Visuals are the base building blocks of the visual layer, representing rectangular areas that can have size, position, opacity, clip, and transform properties. Types include SpriteVisual, ContainerVisual, LayerVisual, ShapeVisual, and RedirectVisual.",
              "type": "text/plain"
            },
