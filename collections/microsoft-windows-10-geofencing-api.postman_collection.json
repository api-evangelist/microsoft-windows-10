          "name": "Microsoft Windows 10 Create a geofence",
          "request": {
            "name": "Microsoft Windows 10 Create a geofence",
            "description": {
              "content": "Creates a new geofence and adds it to the GeofenceMonitor. The geofence is defined by a Geocircle (center point and radius) and monitored states (entered, exited, removed). Supports dwell time, start time, and duration.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "geolocation",
                "geofences"
              ],
              "host": [
