          "name": "Microsoft Windows 10 Get application settings",
          "request": {
            "name": "Microsoft Windows 10 Get application settings",
            "description": {
              "content": "Retrieves application settings from the ApplicationData.LocalSettings or RoamingSettings containers. Settings are stored as key-value pairs in ApplicationDataContainer objects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "storage",
                "app-data",
                "settings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
