          "request": {
            "name": "Microsoft Windows 10 Start BLE advertisement scanning",
            "description": {
              "content": "Starts scanning for BLE advertisements using BluetoothLEAdvertisementWatcher. Discovers nearby BLE devices that are broadcasting advertisement packets. Supports filtering by service UUID, manufacturer data, and signal strength.",
              "type": "text/plain"
            },
