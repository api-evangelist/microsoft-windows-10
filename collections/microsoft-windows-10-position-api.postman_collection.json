          "id": "d8c2bb2a-c4ce-428f-97ad-3a9d36ca050d",
          "name": "Microsoft Windows 10 Get current geographic position",
          "request": {
            "name": "Microsoft Windows 10 Get current geographic position",
            "description": {
              "content": "Retrieves the current geographic position using Geolocator.GetGeopositionAsync. Returns a Geoposition containing a Geocoordinate with latitude, longitude, altitude, accuracy, heading, speed, and timestamp. Accuracy depends on the position source (GNSS ~10m, Wi-Fi ~30-500m, cellular ~300-3000m, IP ~300-10000m).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "geolocation",
                "position"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "desiredAccuracy",
                  "value": "Default",
                  "description": "Desired position accuracy level"
                },
                {
                  "disabled": false,
                  "key": "maximumAge",
                  "value": "<integer>",
                  "description": "Maximum age of cached position in seconds"
                },
                {
                  "disabled": false,
                  "key": "timeout",
                  "value": "<integer>",
                  "description": "Timeout in seconds for obtaining a position"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
