              "name": "Microsoft Windows 10 List composition visuals",
              "id": "77922719-1ba1-43fc-b71b-8741e1611484",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/composition/visuals",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "composition",
                    "visuals"
                  ]
                },
                "description": "Retrieves the list of visual objects in the composition tree. Visuals are the base building blocks of the visual layer, representing rectangular areas that can have size, position, opacity, clip, and transform properties. Types include SpriteVisual, ContainerVisual, LayerVisual, ShapeVisual, and RedirectVisual."
