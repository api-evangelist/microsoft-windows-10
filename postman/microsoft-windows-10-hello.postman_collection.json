{
  "info": {
    "_postman_id": "fcd30a74-95c9-4c90-8291-d0e723f6c5bf",
    "name": "Microsoft Windows 10 Windows Hello Authentication API",
    "description": "Biometric and PIN-based authentication API that replaces passwords with strong two-factor authentication. Based on the Windows.Security.Credentials namespace, Windows Hello supports facial recognition, fingerprint scanning, and PIN-based user verification for secure sign-in. Key classes include KeyCredentialManager, KeyCredentialRetrievalResult, and UserConsentVerifier. Implements the FIDO2/WebAuthn standards for passwordless authentication.\n\nContact Support:\n Name: Microsoft Developer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:12:49.000Z",
    "updatedAt": "2026-06-05T15:12:49.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-fcd30a74-95c9-4c90-8291-d0e723f6c5bf"
  },
