                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/hello/availability",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "hello",
                    "availability"
                  ]
                },
                "description": "Checks whether Windows Hello is available on the device using KeyCredentialManager.IsSupportedAsync. Returns whether the device supports biometric or PIN-based authentication through Windows Hello."
