                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"message\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/hello/verify-user",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "hello",
                    "verify-user"
                  ]
                },
