          "name": "verify-user",
          "item": [
            {
              "name": "Microsoft Windows 10 Verify user identity",
              "id": "d8ece6a2-3e3d-488d-b5d8-8d6d8678d0c9",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
