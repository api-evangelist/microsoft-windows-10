{
  "info": {
    "_postman_id": "5a2a882a-b057-4ab8-8523-c526682fa543",
    "name": "Microsoft Windows 10 Windows Networking API",
    "description": "API for network communication in Windows applications, based on the Windows.Networking.Sockets and Windows.Web.Http namespaces. Provides support for TCP/UDP sockets (StreamSocket, DatagramSocket), WebSockets (MessageWebSocket, StreamWebSocket), HTTP clients (HttpClient), and background transfers (BackgroundDownloader, BackgroundUploader).\n\nContact Support:\n Name: Microsoft Developer Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
