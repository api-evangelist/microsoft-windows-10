        {
          "name": "access",
          "item": [
            {
              "name": "Microsoft Windows 10 Check geolocation access status",
              "id": "0c908738-1a04-4375-b295-57f30cc340a5",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/geolocation/access",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "geolocation",
                    "access"
                  ]
                },
                "description": "Checks the application's permission to access location data using Geolocator.RequestAccessAsync. Returns the current GeolocationAccessStatus indicating whether access is allowed, denied, or unspecified."
              },
              "response": [
                {
                  "id": "4c83a732-2c82-455c-90ef-f057dcf52e54",
                  "name": "Access status retrieved",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "url": {
                      "raw": "{{baseUrl}}/geolocation/access",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "geolocation",
                        "access"
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
                    {
                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "{\n  \"status\": \"Allowed\"\n}",
                  "createdAt": "2026-06-05T15:12:47.000Z",
                  "updatedAt": "2026-06-05T15:12:47.000Z",
                  "uid": "35240-4c83a732-2c82-455c-90ef-f057dcf52e54"
                }
