                        "position"
                      ],
                      "query": [
                        {
                          "description": "Desired position accuracy level",
                          "key": "desiredAccuracy",
                          "value": "Default"
                        },
                        {
                          "description": "Maximum age of cached position in seconds",
                          "key": "maximumAge",
                          "value": "<integer>"
                        },
                        {
                          "description": "Timeout in seconds for obtaining a position",
                          "key": "timeout",
                          "value": "<integer>"
                        }
                      ]
                    }
                  },
                  "status": "OK",
                  "code": 200,
                  "_postman_previewlanguage": "json",
                  "header": [
