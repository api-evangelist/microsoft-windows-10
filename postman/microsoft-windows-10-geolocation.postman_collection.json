        {
          "name": "position",
          "item": [
            {
              "name": "Microsoft Windows 10 Get current geographic position",
              "id": "f7ff128b-9940-4027-8e88-89896c16361c",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/geolocation/position?desiredAccuracy=Default&maximumAge=<integer>&timeout=<integer>",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "geolocation",
                    "position"
                  ],
                  "query": [
                    {
                      "description": "Desired position accuracy level",
                      "key": "desiredAccuracy",
                      "value": "Default"
                    },
                    {
                      "description": "Maximum age of cached position in seconds",
                      "key": "maximumAge",
                      "value": "<integer>"
                    },
                    {
                      "description": "Timeout in seconds for obtaining a position",
                      "key": "timeout",
                      "value": "<integer>"
                    }
                  ]
                },
                "description": "Retrieves the current geographic position using Geolocator.GetGeopositionAsync. Returns a Geoposition containing a Geocoordinate with latitude, longitude, altitude, accuracy, heading, speed, and timestamp. Accuracy depends on the position source (GNSS ~10m, Wi-Fi ~30-500m, cellular ~300-3000m, IP ~300-10000m)."
              },
              "response": [
                {
                  "id": "6ea965ca-5e5a-415f-b788-f18016d1ff50",
                  "name": "Position retrieved successfully",
                  "originalRequest": {
                    "method": "GET",
                    "header": [
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
