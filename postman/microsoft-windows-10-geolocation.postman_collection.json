                      "key": "Content-Type",
                      "value": "application/json"
                    }
                  ],
                  "cookie": [],
                  "responseTime": null,
                  "body": "{\n  \"coordinate\": {\n    \"latitude\": \"<double>\",\n    \"longitude\": \"<double>\",\n    \"accuracy\": \"<double>\",\n    \"timestamp\": \"<dateTime>\",\n    \"altitude\": \"<double>\",\n    \"altitudeAccuracy\": \"<double>\",\n    \"heading\": \"<double>\",\n    \"speed\": \"<double>\",\n    \"positionSource\": \"WiFi\",\n    \"satelliteData\": {\n      \"horizontalDilutionOfPrecision\": \"<double>\",\n      \"verticalDilutionOfPrecision\": \"<double>\",\n      \"geometricDilutionOfPrecision\": \"<double>\"\n    }\n  },\n  \"civicAddress\": {\n    \"city\": \"<string>\",\n    \"country\": \"<string>\",\n    \"state\": \"<string>\",\n    \"postalCode\": \"<string>\"\n  },\n  \"venueData\": {\n    \"id\": \"<string>\",\n    \"level\": \"<string>\"\n  }\n}",
