{
  "info": {
    "_postman_id": "84477ad2-0bb9-41d8-b419-574c34427734",
    "name": "Microsoft Windows 10 Windows Cortana API",
    "description": "API for integrating voice commands and Cortana digital assistant capabilities into Windows applications. Enables voice-activated interactions through Voice Command Definitions (VCD) that specify commands, phrases, and feedback. Applications register VCD files to define custom voice commands that Cortana recognizes and routes to the appropriate app handler.\n\nContact Support:\n Name: Microsoft Developer Support",
