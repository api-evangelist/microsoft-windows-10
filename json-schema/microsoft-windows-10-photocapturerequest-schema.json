{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PhotoCaptureRequest",
  "title": "PhotoCaptureRequest",
  "type": "object",
  "properties": {
    "encodingFormat": {
      "type": "string",
      "enum": [
        "Jpeg",
        "Png",
        "Bmp",
        "Tiff"
      ],
      "default": "Jpeg"
    },
    "outputPath": {
      "type": "string",
      "description": "File path for the captured photo"
    }
  },
  "required": [
    "outputPath"
  ]
}