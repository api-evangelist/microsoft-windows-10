{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/BackgroundTaskDetail",
  "title": "BackgroundTaskDetail",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "entryPoint": {
      "type": "string",
      "description": "Fully qualified class name implementing IBackgroundTask"
    },
    "trigger": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "InternetAvailable",
          "InternetNotAvailable",
          "SessionConnected",
          "SessionDisconnected",
          "UserPresent",
          "UserNotPresent",
          "FreeNetworkAvailable",
          "BackgroundWorkCostNotHigh"
        ]
      }
    },
    "progress": {
      "type": "integer",
      "description": "Current progress (0-100)"
    },
    "lastCompletedTime": {
      "type": "string",
      "format": "date-time"
    },
    "lastRunResult": {
      "type": "string",
      "description": "Result of the last execution"
    }
  }
}