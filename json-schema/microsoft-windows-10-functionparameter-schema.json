  "$id": "#/components/schemas/FunctionParameter",
  "title": "FunctionParameter",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "in",
